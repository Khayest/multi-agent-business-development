{
  "name": "SDR Subagent - Upgrade",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create one personalized outbound sales email draft for the prospect provided below.\n\nProspect:\nFirst name: {{ $json.firstname }}\nLast name: {{ $json.lastname }}\nCompany: {{ $json.company }}\nRole: {{ $json.role }}\nEmail: {{ $json.email }}\nProspecting rationale: {{ $json.rationale }}\n\nThe email is from Ed Donner, CTO of AccountAI, an innovative accounting software company.\n\nRequirements:\n- Create exactly one email for this prospect.\n- Personalize the message using only the prospect information provided above.\n- Keep the email concise and professional.\n- State only that AccountAI provides innovative accounting software designed to streamline costs and drive efficiency.\n- Do not invent facts about the prospect, their company, AccountAI, or its products.\n- If the prospect is interested, invite them to call [DEMO_PHONE_NUMBER] to speak with the AI Agent and schedule a demo.\n- Format the email body in HTML.\n- Use the Gmail draft tool to create a draft addressed only to the supplied prospect email.\n- Create a draft only. Do not send the email.\n- Do not search for or process any other contacts.\n- After creating the draft, return a concise summary of what was created.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        0
      ],
